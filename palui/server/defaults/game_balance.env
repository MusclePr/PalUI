#*ゲームバランス関連

#**ドロップアイテム

#|EnemyDropItemRate|FLOAT|ドロップアイテム量の倍率
ENEMY_DROP_ITEM_RATE=1.000000

#**PvP専用ドロップアイテム

#|bAdditionalDropItemWhenPlayerKillingInPvPMode|BOOL|PvP有効化状態でプレイヤーをキルしたとき、専用アイテムをドロップするか
ADDITIONAL_DROP_ITEM_WHEN_PLAYER_KILLING_IN_PVP_MODE_ENABLED=False
#|AdditionalDropItem|ARRAY|ドロップするアイテムのID
ADDITIONAL_DROP_ITEM_WHEN_PLAYER_KILLING_IN_PVP_MODE=PlayerDropItem
#|AdditionalDropItemNumWhenPlayerKillingInPvPMode|INT|ドロップするアイテムの量
ADDITIONAL_DROP_ITEM_NUM_WHEN_PLAYER_KILLING_IN_PVP_MODE=1

#**補給物資

#|SupplyDropSpan|INT|補給物資の出現間隔（秒）
SUPPLY_DROP_SPAN=180

#**死亡時

#|DeathPenalty|CHOICE(None,Item,ItemAndEquipment,All)|デスペナルティ(None : ロスト無し, Item : 装備品以外のアイテム, ItemAndEquipment : すべての装備品とアイテム, All : 全ての装備品と装備品と手持ちパル）
DEATH_PENALTY=Item
#|BlockRespawnTime|FLOAT|死亡後リスポーンするまでのクールタイム（秒）
BLOCK_RESPAWN_TIME=5.000000
#|PalLost|BOOL|死亡時にパルを永久的にロストするか
PAL_LOST=False
#|RespawnPenaltyTimeScale|FLOAT|リスポーンクールタイムに適用する倍率
RESPAWN_PENALTY_TIME_SCALE=2.000000
#|RespawnPenaltyDurationThreshold|FLOAT|再死亡時にRespawnPenaltyTimeScaleで設定したクールタイム倍率を適用する生存時間の閾値（秒）
RESPAWN_PENALTY_DURATION_THRESHOLD=0.000000

#**建造物

#|BuildObjectHpRate|FLOAT|建造物のHP倍率
BUILD_OBJECT_HP_RATE=1.000000
#|BuildObjectDamageRate|FLOAT|建築物に対するダメージ倍率
BUILD_OBJECT_DAMAGE_RATE=1.000000
#|BuildObjectDeteriorationDamageRate|FLOAT|建築物の劣化速度倍率
BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=1.000000

#**採取

#|CollectionDropRate|FLOAT|採集アイテムの入手量倍率
COLLECTION_DROP_RATE=1.000000
#|CollectionObjectHpRate|FLOAT|採集オブジェクトのHP倍率
COLLECTION_OBJECT_HP_RATE=1.000000
#|CollectionObjectRespawnSpeedRate|FLOAT|採集オブジェクトのリスポーン間隔
COLLECTION_OBJECT_RESPAWN_SPEED_RATE=1.000000

#**時間

#|DaytimeSpeedRate|FLOAT|昼の経過速度
DAYTIME_SPEEDRATE=1.000000
#|NighttimeSpeedRate|FLOAT|夜の経過速度
NIGHTTIME_SPEEDRATE=1.000000

#**テクノロジー

#|DenyTechnologyList|ARRAY|無効化するテクノロジーを設定（例：("PALBOX", "RepairBench")）
DENY_TECHNOLOGY_LIST=

#**装備

#|EquipmentDurabilityDamageRate|FLOAT|装備品の耐久度減少倍率
EQUIPMENT_DURABILITY_DAMAGE_RATE=1.000000

#**経験値

#|ExpRate|FLOAT|経験値の入手倍率
EXP_RATE=1.000000

#**釣り

#|FishingDifficultyRate|FLOAT|釣りの難易度　0.1~1.0
FISHING_DIFFICULTY_RATE=1.000000

#**ギルド

#|GuildPlayerMaxNum|INT|ギルドの最大人数
GUILD_PLAYER_MAX_NUM=20
#|GuildRejoinCooldownMinutes|INT|ギルド再加入クールタイム（分）
GUILD_REJOIN_COOLDOWN_MINUTES=0

#**アイテム

#|ItemCorruptionMultiplier|FLOAT|アイテムの腐敗速度倍率
ITEM_CORRUPTION_MULTIPLIER=1.000000
#|ItemWeightRate|FLOAT|アイテム重量倍率
ITEM_WEIGHT_RATE=1.000000

#**放牧

#|MonsterFarmActionSpeedRate|FLOAT|放牧によるアイテムの生産速度倍率
MONSTER_FARM_ACTION_SPEED_RATE=1.000000

#**パル

#|PalAutoHpRegenRate|FLOAT|パルのHP自然回復倍率
PAL_AUTO_HP_REGEN_RATE=1.000000
#|PalAutoHpRegenRateInSleep|FLOAT|パルの睡眠時HP回復倍率(パルボックス内)
