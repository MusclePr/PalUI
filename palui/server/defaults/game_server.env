#*サーバー関連

#**基本設定

#|ServerName|STR|サーバー名
SERVER_NAME="palworld-server-docker by Thijs van Loef"
#|ServerDescription|STR|サーバー説明
SERVER_DESCRIPTION="palworld-server-docker by Thijs van Loef"
#|PORT (-port)|INT|サーバーの待ち受けポート（デフォルト: 8211）
PORT=8211
##|ServerPlayerMaxNum|INT(1,32)|サーバーに参加できる最大人数
#SERVER_PLAYER_MAX_NUM=16
#|PLAYERS (-players & ServerPlayerMaxNum)|INT(1,32)|サーバーの最大参加人数を変更します。
PLAYERS=16
#|Region|STR|サーバーのリージョンを指定
REGION=""

##**セキュリティ

#|AdminPassword|PASSWORD|サーバーの管理者権限を取得するのに使用するパスワード
ADMIN_PASSWORD="adminPasswordHere"
#|ServerPassword|PASSWORD|サーバーのログインに必要なパスワード
SERVER_PASSWORD="worldofpals"
#|UseAuth|BOOL|認証を使用するかどうか
USEAUTH=True
#|ChatPostLimitPerMinute|INT|1分間に投稿可能なチャット数
CHAT_POST_LIMIT_PER_MINUTE=30
#|CrossplayPlatforms|SELECT(Steam,Xbox,PS5,Mac)|接続を許可するプラットフォーム
CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)
#|bAllowClientMod|BOOL|Modを有効化しているユーザーのサーバー参加を許可するか
ALLOW_CLIENT_MOD=True

#**コミュニティサーバー設定

#|COMMUNITY (-publiclobby)|BOOL|コミュニティサーバーとして設定します。
COMMUNITY=true
#|PublicPort (-publicport)|INT|コミュニティサーバー設定において、外部公開ポートを明示的に指定（この設定ではサーバーの待ち受けポートは変更されません）
PUBLIC_PORT=8211
#|PublicIp (-publicip)|STR|コミュニティサーバー設定において、外部公開IPを明示的に指定
PUBLIC_IP=""

#**BANリスト設定

#|BanListUrl|STR|BANリストのURL
BAN_LIST_URL="https://b.palworldgame.com/api/banlist.txt"

#**ログ設定
#|LogFormatType (-logformat)|STR|ログフォーマットの指定 Text または Json
LOG_FORMAT_TYPE=default

#**ゲーム内メッセージ設定

#|bIsShowJoinLeftMessage|BOOL|プレイヤーの参加・退出時にゲーム内メッセージを表示するかどうか
IS_SHOW_JOIN_LEFT_MESSAGE=True

#**自動保存設定

#|AutoSaveSpan|FLOAT|自動保存の間隔（秒）
AUTO_SAVE_SPAN=30.000000
#|bIsUseBackupSaveData|BOOL|ワールドバックアップの有効化（有効化するとディスクへの負荷が高まります。）
USE_BACKUP_SAVE_DATA=True

#**REST API 設定

#|RestApiEnabled|BOOL|REST APIを有効化
REST_API_ENABLED=true
#|RestApiPort|INT|REST APIの待ち受けポート
REST_API_PORT=8212

#**RCON 設定（廃止予定）

#|RconEnabled|BOOL|RCONを有効化
RCON_ENABLED=true
#|RconPort|INT|RCONで使用するポート番号
RCON_PORT=25575

#**GAMEDATA API 設定

#|ENABLE_GAMEDATA_API (-enable-gamedata-api)|BOOL|GAMEDATA APIを有効にする
ENABLE_GAMEDATA_API=true
