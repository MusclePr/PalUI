#*システム設定

#**タイムゾーン

#|TZ|STR|サーバーのタイムゾーン
TZ="Asia/Tokyo"

#**ユーザー設定

#|PUID|INT|サーバーを実行するユーザー(steam)のUID
PUID=1000
#|PGID|INT|サーバーを実行するユーザー(steam)のGID
PGID=1000

#**パフォーマンス・チューニング

#|ENABLE_PERF_THREADING_ARGS (-useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS)|BOOL|パフォーマンス関連のスレッド起動引数を有効にします。 v1.0以降では、このパラメータを 設定しないほうがパフォーマンス向上が期待できます。
ENABLE_PERF_THREADING_ARGS=false
#|WORKER_THREADS_SERVER (-NumberOfWorkerThreadsServer)|INT|プロセススレッド数を設定します。 マルチスレッド最適化の引数と合わせて使用する必要があります。 ゲームのデフォルト設定を使用する場合は、空欄のままにしてください。
WORKER_THREADS_SERVER=

#**起動／再起動時の処理

#|UPDATE_ON_BOOT|BOOL|起動時にサーバーを更新する
UPDATE_ON_BOOT=true

#|MOD_UPDATE_ON_BOOT|BOOL|起動時にMODを更新する（MODが有効な場合）
MOD_UPDATE_ON_BOOT=true

#|PALWORLD_ALLOW_NEGATIVE_DELTA_TIME|BOOL|Engine iniファイルの上書きにより、Palworldに組み込まれている負のDeltaTimeに対するリカバリ機能を有効にします。このオプトインによる対策は、ホストまたはVMのクロックを修正または同期するものではありません。
PALWORLD_ALLOW_NEGATIVE_DELTA_TIME=false

#**AUTO BACKUP設定

#|BACKUP_ENABLED|BOOL|自動バックアップ機能を有効にする
BACKUP_ENABLED=true
#|BACKUP_CRON_EXPRESSION|STR|自動バックアップの実行スケジュールをCron形式で指定します。
BACKUP_CRON_EXPRESSION=0 0 * * *
#|DELETE_OLD_BACKUPS|BOOL|古いバックアップを自動的に削除するかどうかを設定します。
DELETE_OLD_BACKUPS=false
#|OLD_BACKUP_DAYS|INT|古いバックアップを削除する際の基準日数を設定します。
OLD_BACKUP_DAYS=30

#**AUTO UPDATE設定

#|AUTO_UPDATE_ENABLED|BOOL|自動更新機能を有効にする
AUTO_UPDATE_ENABLED=true
#|AUTO_UPDATE_CRON_EXPRESSION|STR|自動更新の実行スケジュールをCron形式で指定します。
AUTO_UPDATE_CRON_EXPRESSION=0 * * * *
#|AUTO_UPDATE_WARN_MINUTES|INT|自動更新の警告を出すまでの時間（分）
AUTO_UPDATE_WARN_MINUTES=30

#**AUTO REBOOT設定

#|AUTO_REBOOT_ENABLED|BOOL|自動再起動機能を有効にする
AUTO_REBOOT_ENABLED=false
#|AUTO_REBOOT_CRON_EXPRESSION|STR|自動再起動の実行スケジュールをCron形式で指定します。
AUTO_REBOOT_CRON_EXPRESSION=0 0 * * *
#|AUTO_REBOOT_WARN_MINUTES|INT|自動再起動の警告を出すまでの時間（分）
AUTO_REBOOT_WARN_MINUTES=5

#**AUTO PAUSE設定

#|AUTO_PAUSE_ENABLED|BOOL|AUTO PAUSE機能を有効にする
AUTO_PAUSE_ENABLED=true
#|AUTO_PAUSE_TIMEOUT_EST|INT|AUTO PAUSEが発動するまでの待機時間（秒）
AUTO_PAUSE_TIMEOUT_EST=10
#|AUTO_PAUSE_LOG|BOOL|AUTO PAUSEのログを出力する
AUTO_PAUSE_LOG=true
#|AUTO_PAUSE_DEBUG|BOOL|AUTO PAUSEのデバッグモードを有効にする
AUTO_PAUSE_DEBUG=false
#|AUTO_PAUSE_KNOCKD_IF|STR|knockdの監視対象のインターフェイスを設定します。デフォルトはautoです。
AUTO_PAUSE_KNOCKD_IF=auto

#**Discord設定

#|DISCORD_WEBHOOK_URL|STR|DiscordのWebhook URLを指定します。
DISCORD_WEBHOOK_URL=
#|DISCORD_SUPPRESS_NOTIFICATIONS|BOOL|Discord通知に、@silent を付けて通知を抑制します。
DISCORD_SUPPRESS_NOTIFICATIONS=false
#|DISCORD_CONNECT_TIMEOUT|INT|Discord通知の接続タイムアウト（秒）
DISCORD_CONNECT_TIMEOUT=30
#|DISCORD_MAX_TIMEOUT|INT|Discord通知の最大タイムアウト（秒）
DISCORD_MAX_TIMEOUT=30
#|DISCORD_PRE_UPDATE_BOOT_MESSAGE_ENABLED|BOOL|サーバー更新前のメッセージを有効にするかどうかを設定します。
DISCORD_PRE_UPDATE_BOOT_MESSAGE_ENABLED=true
#|DISCORD_PRE_UPDATE_BOOT_MESSAGE|STR|サーバー更新前のメッセージ
DISCORD_PRE_UPDATE_BOOT_MESSAGE="Server is updating..."
#|DISCORD_PRE_UPDATE_BOOT_MESSAGE_URL|STR|サーバー更新前のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PRE_UPDATE_BOOT_MESSAGE_URL=
#|DISCORD_POST_UPDATE_BOOT_MESSAGE_ENABLED|BOOL|サーバー更新後のメッセージを有効にするかどうかを設定します。
DISCORD_POST_UPDATE_BOOT_MESSAGE_ENABLED=true
#|DISCORD_POST_UPDATE_BOOT_MESSAGE|STR|サーバー更新後のメッセージ
DISCORD_POST_UPDATE_BOOT_MESSAGE="Server update complete!"
#|DISCORD_POST_UPDATE_BOOT_MESSAGE_URL|STR|サーバー更新後のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_POST_UPDATE_BOOT_MESSAGE_URL=
#|DISCORD_PRE_START_MESSAGE_ENABLED|BOOL|サーバー起動前のメッセージを有効にするかどうかを設定します。
DISCORD_PRE_START_MESSAGE_ENABLED=true
#|DISCORD_PRE_START_MESSAGE|STR|サーバー起動前のメッセージ
DISCORD_PRE_START_MESSAGE="Server has been started!"
#|DISCORD_PRE_START_MESSAGE_URL|STR|サーバー起動前のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PRE_START_MESSAGE_URL=
#|DISCORD_PRE_SHUTDOWN_MESSAGE_ENABLED|BOOL|サーバーシャットダウン前のメッセージを有効にするかどうかを設定します。
DISCORD_PRE_SHUTDOWN_MESSAGE_ENABLED=true
#|DISCORD_PRE_SHUTDOWN_MESSAGE|STR|サーバーシャットダウン前のメッセージ
DISCORD_PRE_SHUTDOWN_MESSAGE="Server is shutting down..."
#|DISCORD_PRE_SHUTDOWN_MESSAGE_URL|STR|サーバーシャットダウン前のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PRE_SHUTDOWN_MESSAGE_URL=
#|DISCORD_POST_SHUTDOWN_MESSAGE_ENABLED|BOOL|サーバーシャットダウン後のメッセージを有効にするかどうかを設定します。
DISCORD_POST_SHUTDOWN_MESSAGE_ENABLED=true
#|DISCORD_POST_SHUTDOWN_MESSAGE|STR|サーバーシャットダウン後のメッセージ
DISCORD_POST_SHUTDOWN_MESSAGE="Server has been stopped!"
#|DISCORD_POST_SHUTDOWN_MESSAGE_URL|STR|サーバーシャットダウン後のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_POST_SHUTDOWN_MESSAGE_URL=
#|DISCORD_PLAYER_JOIN_MESSAGE_ENABLED|BOOL|プレイヤーがサーバーに参加した際のメッセージを有効にするかどうかを設定します。
DISCORD_PLAYER_JOIN_MESSAGE_ENABLED=true
#|DISCORD_PLAYER_JOIN_MESSAGE|STR|プレイヤーがサーバーに参加した際のメッセージ
DISCORD_PLAYER_JOIN_MESSAGE="player_name has joined Palworld!"
#|DISCORD_PLAYER_JOIN_MESSAGE_URL|STR|プレイヤーがサーバーに参加した際のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PLAYER_JOIN_MESSAGE_URL=
#|DISCORD_PLAYER_LEAVE_MESSAGE_ENABLED|BOOL|プレイヤーがサーバーから退出した際のメッセージを有効にするかどうかを設定します。
DISCORD_PLAYER_LEAVE_MESSAGE_ENABLED=true
#|DISCORD_PLAYER_LEAVE_MESSAGE|STR|プレイヤーがサーバーから退出した際のメッセージ
DISCORD_PLAYER_LEAVE_MESSAGE="player_name has left Palworld."
#|DISCORD_PLAYER_LEAVE_MESSAGE_URL|STR|プレイヤーがサーバーから退出した際のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PLAYER_LEAVE_MESSAGE_URL=
#|DISCORD_PRE_BACKUP_MESSAGE_ENABLED|BOOL|バックアップ作成前のメッセージを有効にするかどうかを設定します。
DISCORD_PRE_BACKUP_MESSAGE_ENABLED=true
#|DISCORD_PRE_BACKUP_MESSAGE|STR|バックアップ作成前のメッセージ
DISCORD_PRE_BACKUP_MESSAGE="Creating backup..."
#|DISCORD_PRE_BACKUP_MESSAGE_URL|STR|バックアップ作成前のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PRE_BACKUP_MESSAGE_URL=
#|DISCORD_POST_BACKUP_MESSAGE_ENABLED|BOOL|バックアップ作成後のメッセージを有効にするかどうかを設定します。
DISCORD_POST_BACKUP_MESSAGE_ENABLED=true
#|DISCORD_POST_BACKUP_MESSAGE|STR|バックアップ作成後のメッセージ
DISCORD_POST_BACKUP_MESSAGE="Backup created at file_path"
#|DISCORD_POST_BACKUP_MESSAGE_URL|STR|バックアップ作成後のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_POST_BACKUP_MESSAGE_URL=
#|DISCORD_PRE_BACKUP_DELETE_MESSAGE_ENABLED|BOOL|古いバックアップ削除前のメッセージを有効にするかどうかを設定します。
DISCORD_PRE_BACKUP_DELETE_MESSAGE_ENABLED=true
#|DISCORD_PRE_BACKUP_DELETE_MESSAGE|STR|古いバックアップ削除前のメッセージ
DISCORD_PRE_BACKUP_DELETE_MESSAGE="Removing backups older than old_backup_days days"
#|DISCORD_PRE_BACKUP_DELETE_MESSAGE_URL|STR|古いバックアップ削除前のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_PRE_BACKUP_DELETE_MESSAGE_URL=
#|DISCORD_POST_BACKUP_DELETE_MESSAGE_ENABLED|BOOL|古いバックアップ削除後のメッセージを有効にするかどうかを設定します。
DISCORD_POST_BACKUP_DELETE_MESSAGE_ENABLED=true
#|DISCORD_POST_BACKUP_DELETE_MESSAGE|STR|古いバックアップ削除後のメッセージ
DISCORD_POST_BACKUP_DELETE_MESSAGE="Removed backups older than old_backup_days days"
#|DISCORD_POST_BACKUP_DELETE_MESSAGE_URL|STR|古いバックアップ削除後のメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_POST_BACKUP_DELETE_MESSAGE_URL=
#|DISCORD_ERR_BACKUP_DELETE_MESSAGE_ENABLED|BOOL|古いバックアップ削除エラーメッセージを有効にするかどうかを設定します。
DISCORD_ERR_BACKUP_DELETE_MESSAGE_ENABLED=true
#|DISCORD_ERR_BACKUP_DELETE_MESSAGE|STR|古いバックアップ削除エラーメッセージ
DISCORD_ERR_BACKUP_DELETE_MESSAGE="Unable to delete old backups, OLD_BACKUP_DAYS is not an integer. OLD_BACKUP_DAYS=old_backup_days"
#|DISCORD_ERR_BACKUP_DELETE_MESSAGE_URL|STR|古いバックアップ削除エラーメッセージの送信先URL（空ならデフォルトのWebhook URLが使用されます）
DISCORD_ERR_BACKUP_DELETE_MESSAGE_URL=

#**Steam ログイン設定（バージョン指定や、MOD 利用時に必要です）

#|STEAM_USERNAME|STR|Steamのユーザー名を指定します。
STEAM_USERNAME=
#|STEAM_PASSWORD|STR|Steamのパスワードを指定します。
STEAM_PASSWORD=

#**バージョン指定（デバッグ向け）

#|TARGET_MANIFEST_ID|STR|固定するバージョンのマニフェストIDを指定します。空欄の場合は最新のマニフェストが使用されます。
TARGET_MANIFEST_ID=

#|INSTALL_BETA_INSIDER|BOOL|ベータ版やインサイダープログラムをインストールするかどうかを設定します。
INSTALL_BETA_INSIDER=false

#**MOD 設定

#|MOD_ENABLED|BOOL|MOD機能を有効にする
MOD_ENABLED=true
#|MOD_IDS|STR|有効にするMODのID（カンマ区切りで複数指定可能）
MOD_IDS="3625287786"
