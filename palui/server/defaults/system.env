#*システム設定

#**オンライン

#|COMMUNITY|BOOL|非公式サーバーリストの一覧に表示する
COMMUNITY=true

#**更新

#|UPDATE_ON_BOOT|BOOL|起動時に更新を行う
UPDATE_ON_BOOT=true

#**AUTO PAUSE設定

#|AUTO_PAUSE_ENABLED|BOOL|AUTO PAUSE機能を有効にする
AUTO_PAUSE_ENABLED=true
#|AUTO_PAUSE_TIMEOUT_EST|INT|AUTO PAUSEが発動するまでの待機時間（秒）
AUTO_PAUSE_TIMEOUT_EST=10
#|AUTO_PAUSE_LOG|BOOL|AUTO PAUSEのログを出力する
AUTO_PAUSE_LOG=true

#**GAMEDATA API設定

#|ENABLE_GAMEDATA_API|BOOL|GAMEDATA APIを有効にする
ENABLE_GAMEDATA_API=true

#**ログ設定

#|LOG_LEVEL|STR|ログの出力レベル（例: "INFO", "DEBUG", "ERROR"）
LOG_LEVEL="INFO"

#**MOD設定

#|MOD_ENABLED|BOOL|MOD機能を有効にする
MOD_ENABLED=true
#|MOD_UPDATE_ON_BOOT|BOOL|起動時にMODを更新する
MOD_UPDATE_ON_BOOT=true
#|MOD_IDS|STR|有効にするMODのID（カンマ区切りで複数指定可能）
MOD_IDS="3625287786"
