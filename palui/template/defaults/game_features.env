#*ゲーム機能関連

#**ステータス割り当て

#|bAllowEnhanceStatAttack|BOOL|「攻撃」へのステータス割り当てを許可するか
ALLOW_ENHANCE_STAT_ATTACK=True
#|bAllowEnhanceStatHealth|BOOL|「体力」へのステータス割り当てを許可するか
ALLOW_ENHANCE_STAT_HEALTH=True
#|bAllowEnhanceStatStamina|BOOL|「スタミナ」へのステータス割り当てを許可するか
ALLOW_ENHANCE_STAT_STAMINA=True
#|bAllowEnhanceStatWeight|BOOL|「所持重量」へのステータス割り当てを許可するか
ALLOW_ENHANCE_STAT_WEIGHT=True
#|bAllowEnhanceStatWorkSpeed|BOOL|「作業速度」へのステータス割り当てを許可するか
ALLOW_ENHANCE_STAT_WORK_SPEED=True

#**グローバルパルボックス

#|bAllowGlobalPalboxExport|BOOL|グローバルパルボックスへの保存を可能にするか
ALLOW_GLOBAL_PALBOX_EXPORT=True
#|bAllowGlobalPalboxImport|BOOL|グローバルパルボックスからの読み込みを可能にするか
ALLOW_GLOBAL_PALBOX_IMPORT=False

#**ギルド

#|bAutoResetGuildNoOnlinePlayers|BOOL|ギルド所属プレイヤーが誰もログインしなかった場合に建築物や拠点パルを自動的に削除するかどうか。
AUTO_RESET_GUILD_NO_ONLINE_PLAYERS=False
#|AutoResetGuildTimeNoOnlinePlayers|FLOAT|上記が発動するまでのオフライン時間。
AUTO_RESET_GUILD_TIME_NO_ONLINE_PLAYERS=72.000000

#**建築

#|bBuildAreaLimit|BOOL|ファストトラベルなどの構造物付近で建築を禁止するか
BUILD_AREA_LIMIT=False

#**ハードコア

#|bHardcore|BOOL|ハードコアの有効化 死亡時リスポーンできなくなります。
HARDCORE=False
#|bCharacterRecreateInHardcore|BOOL|ハードコア設定時の死亡時のキャラクター再作成可否
CHARACTER_RECREATE_IN_HARDCORE=False

#**PvP

#|bIsPvp|BOOL|PvPを有効化するかどうか
IS_PVP=False

#**マップ

#|bDisplayPvpItemNumOnWorldMapBaseCamp|BOOL|各拠点内にあるPvP専用アイテムの個数をマップ上に表示するか
DISPLAY_PVP_ITEM_NUM_ON_WORLD_MAP_BASE_CAMP=False
#|bDisplayPvpItemNumOnWorldMapPlayer|BOOL|プレイヤーの位置とPvP専用アイテム数をマップに表示するか
DISPLAY_PVP_ITEM_NUM_ON_WORLD_MAP_PLAYER=False

#**ボイスチャット

#|bEnableVoiceChat|BOOL|ボイスチャット機能を有効化するか
ENABLE_VOICE_CHAT=False
#|VoiceChatMaxVolumeDistance|FLOAT|ボイスチャットの通話音量を減衰させない距離
VOICE_CHAT_MAX_VOLUME_DISTANCE=3000.000000
#|VoiceChatZeroVolumeDistance|FLOAT|ボイスチャットの通話音量を0にする距離
VOICE_CHAT_ZERO_VOLUME_DISTANCE=15000.000000

#**野生パルのレベルのランダム化

#|bIsRandomizerPalLevelRandom|BOOL|true にすると野生パルのレベルを完全にランダムにします。false にするとエリアに見合ったレベル内でランダム化されます。
IS_RANDOMIZER_PAL_LEVEL_RANDOM=False
#|RandomizerSeed|STR|出現パルのランダムモードを設定した際のシード値
RANDOMIZER_SEED=""
#|RandomizerType|STR|出現パルのランダムモードを設定（None : ランダム化しない, Region : 地域ごとにランダム化, All : 完全にランダム化）
RANDOMIZER_TYPE=None

#**その他

#|bEnableFastTravel|BOOL|ファストトラベルを有効化するか
ENABLE_FAST_TRAVEL=True
#|bEnableInvaderEnemy|BOOL|襲撃を有効化するか
ENABLE_INVADER_ENEMY=True
#|bExistPlayerAfterLogout|BOOL|ログアウト時にプレイヤーがその場で寝た状態にするか
EXIST_PLAYER_AFTER_LOGOUT=False
#|bInvisibleOtherGuildBaseCampAreaFx|BOOL|拠点範囲表示
INVISIBLE_OTHER_GUILD_BASE_CAMP_AREA_FX=False
#|bIsStartLocationSelectByMap|BOOL|ゲーム開始地点を選べるようにするか
IS_START_LOCATION_SELECT_BY_MAP=False
#|ShowPlayerList|BOOL|ESCキーで表示される画面での参加者一覧を有効化
SHOW_PLAYER_LIST=False
