#*パフォーマンス関連

#**拠点

#|BaseCampMaxNum|INT(1,128)|サーバー全体の拠点数
BASE_CAMP_MAX_NUM=128
#|BaseCampMaxNumInGuild|INT(1,10)|ギルド当たりの最大拠点数 デフォルト4 (最大10)（値を大きくするほど処理負荷が増大します）
BASE_CAMP_MAX_NUM_IN_GUILD=4
#|BaseCampWorkerMaxNum|INT(1,50)|拠点当たりの最大パル数（最大50）（値を大きくするほど処理負荷が増大します）
BASE_CAMP_WORKER_MAX_NUM=15

#**コンテナ

#|ItemContainerForceMarkDirtyInterval|FLOAT|コンテナを開いている際に強制的に同期しなおす頻度（秒）
ITEM_CONTAINER_FORCE_MARK_DIRTY_INTERVAL=1.000000

#**建築

#|MaxBuildingLimitNum|INT|プレイヤーごとに建築物数制限 (0 = 無制限)
MAX_BUILDING_LIMIT_NUM=0

#**物理演算

#|PhysicsActiveDropItemMaxNum|INT|ドロップアイテムが物理挙動をする上限数
PHYSICS_ACTIVE_DROP_ITEM_MAX_NUM=-1

#**同期距離

#|ServerReplicatePawnCullDistance|FLOAT(5000,15000)|プレイヤーからのPalの同期距離（cm） 最小5000~最大15000
SERVER_REPLICATE_PAWN_CULL_DISTANCE=15000.000000
